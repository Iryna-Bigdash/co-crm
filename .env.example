# Public token used by the frontend API client.
NEXT_PUBLIC_PROJECT_TOKEN=your_project_token

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret

# GitHub OAuth app credentials (https://github.com/settings/developers).
GITHUB_ID=your_github_oauth_app_id
GITHUB_SECRET=your_github_oauth_app_secret

# Base URL of this frontend app (used by NextAuth).
NEXTAUTH_URL=http://localhost:3001

# Base URL of the co-crm-api backend.
NEXT_PUBLIC_API_URL=http://localhost:3000
