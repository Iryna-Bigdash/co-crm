# Must match backend API_SECRET.
NEXT_PUBLIC_PROJECT_TOKEN=your_local_dev_token

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret

# GitHub OAuth app credentials.
GITHUB_ID=your_github_oauth_app_id
GITHUB_SECRET=your_github_oauth_app_secret

# Comma-separated emails allowed to sign in via GitHub as admin.
GITHUB_ADMIN_EMAILS=admin@example.com

# Base URL of this frontend app.
NEXTAUTH_URL=http://localhost:3001

# Base URL of the co-crm-api backend (no trailing slash).
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000

# Optional: used by next-sitemap during build.
SITE_URL=http://localhost:3001
